<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>CloudNimble.EasyAF.Benchmarks</RootNamespace>
        <!-- BenchmarkDotNet requires instance benchmark methods, even ones that touch no instance state. -->
        <NoWarn>$(NoWarn);CA1822</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Ben.TypeDictionary reproduces the EasyAF 4.x EntityManager lookup in AuditInterfaceBenchmarks. -->
        <PackageReference Include="Ben.TypeDictionary" Version="[*, 2.0.0)" />
        <PackageReference Include="BenchmarkDotNet" Version="0.15.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CloudNimble.EasyAF.Core\CloudNimble.EasyAF.Core.csproj" />
        <ProjectReference Include="..\CloudNimble.EasyAF.Http.NewtonsoftJson\CloudNimble.EasyAF.Http.NewtonsoftJson.csproj" />
        <ProjectReference Include="..\CloudNimble.EasyAF.Http.SystemTextJson\CloudNimble.EasyAF.Http.SystemTextJson.csproj" />
    </ItemGroup>

    <!-- The same generated entities Tests.Shared compiles, without Tests.Shared's EF6 dependencies. -->
    <ItemGroup>
        <Compile Include="..\CloudNimble.EasyAF.Tests.CodeGen\Baselines\Entities\*.Generated.cs" LinkBase="EasyAFModel" />
    </ItemGroup>

</Project>
