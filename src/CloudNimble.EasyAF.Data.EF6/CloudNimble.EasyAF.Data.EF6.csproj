<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Leave .NET 4.8 in here first so that the tests and EDMX designer pick up the NET 4.8 reference first.-->
        <TargetFrameworks>net48;net11.0;net10.0;</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.*" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="[7.*, 8.0.0)" />
        <PackageReference Include="Microsoft.EntityFramework.SqlServer" Version="[6.*, 7.0.0)" />
    </ItemGroup>

    <!-- SqlClient 7.1.1 floors System.Security.Cryptography.Pkcs at vulnerable versions (CVE-2026-84008, CVE-2026-70162). -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[11.*-*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[8.*, 12.0.0)" />
    </ItemGroup>

</Project>
