<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>EasyAF</PackageId>
        <PackAsTool>True</PackAsTool>
    </PropertyGroup>

    <PropertyGroup>
        <ToolCommandName>dotnet-easyaf</ToolCommandName>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net11.0;net10.0;</TargetFrameworks>
        <NoWarn>$(NoWarn);CA1822;NU1701;NU1608;</NoWarn>
        <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
        <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
        <!-- Lets the tool run on a newer runtime (e.g. .NET 11) when no matching one is installed. -->
        <RollForward>Major</RollForward>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" Version="5.*" />
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.*" />
    </ItemGroup>

    <!-- EF Core Design ships Microsoft.Build.Framework; keep it out of the output so MSBuildLocator loads the SDK's copy. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.Build.Framework" Version="18.10.*" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.*-*" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.*-*" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="11.*-*" />
        <!-- TemplateEngine 11.x previews depend on NuGet.* rc builds that are not on nuget.org; the net10.0 asset of 10.x runs on net11. -->
        <PackageReference Include="Microsoft.TemplateEngine.Edge" Version="10.*" />
        <PackageReference Include="Microsoft.TemplateEngine.IDE" Version="10.*" />
        <PackageReference Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" Version="10.*" />
        <PackageReference Include="Microsoft.TemplateEngine.Utils" Version="10.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Build.Framework" Version="18.9.*" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" />
        <PackageReference Include="Microsoft.TemplateEngine.Edge" Version="10.*" />
        <PackageReference Include="Microsoft.TemplateEngine.IDE" Version="10.*" />
        <PackageReference Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" Version="10.*" />
        <PackageReference Include="Microsoft.TemplateEngine.Utils" Version="10.*" />
    </ItemGroup>

    <!-- TemplateEngine ships NuGet.* 6.13; keep them out of the output so MSBuildLocator loads the SDK's copies, which MSBuild needs to evaluate SDK projects. -->
    <ItemGroup>
        <PackageReference Include="NuGet.Common" Version="6.13.*" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Configuration" Version="6.13.*" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Credentials" Version="6.13.*" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Frameworks" Version="6.13.*" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Packaging" Version="6.13.*" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Protocol" Version="6.13.*" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Versioning" Version="6.13.*" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CloudNimble.EasyAF.CodeGen\CloudNimble.EasyAF.CodeGen.csproj" />
        <ProjectReference Include="..\CloudNimble.EasyAF.EFCoreToEdmx\CloudNimble.EasyAF.EFCoreToEdmx.csproj" />
        <ProjectReference Include="..\CloudNimble.EasyAF.MSBuild\CloudNimble.EasyAF.MSBuild.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="deps.json" />
    </ItemGroup>

    <!-- Scaffolding templates for `dotnet easyaf new`. Their .cs files contain {{Token}} placeholders, so they are embedded, never compiled. -->
    <ItemGroup>
        <Compile Remove="Resources\**" />
        <None Remove="Resources\**" />
        <EmbeddedResource Include="Resources\**">
            <LogicalName>$([System.String]::Copy('%(RelativeDir)%(Filename)%(Extension)').Replace('\', '/'))</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Update="App.Config2">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
