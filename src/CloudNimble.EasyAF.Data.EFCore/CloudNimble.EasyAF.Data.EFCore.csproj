<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;</TargetFrameworks>
        <DefineConstants>EFCORE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.*" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="[7.*, 8.0.0)" />
        <!--<PackageReference Include="System.Runtime.Caching" Version="9.*" ExcludeAssets="All" />-->
    </ItemGroup>

    <!-- SqlClient 7.1.1 floors System.Security.Cryptography.Pkcs at vulnerable versions (CVE-2026-84008, CVE-2026-70162). -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[11.*-*, 12.0.0)" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[11.*-*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[10.*, 12.0.0)" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CloudNimble.EasyAF.Core\CloudNimble.EasyAF.Core.csproj" />
    </ItemGroup>

</Project>
