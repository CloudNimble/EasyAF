        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="[11.*-*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="[10.*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[3.1.0, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="[3.1.0, 12.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CloudNimble.EasyAF.Core\CloudNimble.EasyAF.Core.csproj" />
    </ItemGroup>

