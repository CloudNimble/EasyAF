<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;</TargetFrameworks>
        <DefineConstants>EFCORE</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <Title>EasyAF Restier API for EF Core</Title>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Restier.AspNetCore" Version="1.*-*" NoWarn="NU5104;NU1605" />
        <PackageReference Include="Microsoft.Restier.EntityFrameworkCore" Version="1.*-*" NoWarn="NU5104;NU1605" />
        <PackageReference Include="SimpleMessageBus.Publish" Version="6.*-*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='net11.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[11.*-*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[11.*-*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CloudNimble.EasyAF.Restier\CloudNimble.EasyAF.Restier.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <Compile Include="..\CloudNimble.EasyAF.Restier.EF6\EasyAFEntityFrameworkApi.cs" Link="EasyAFEntityFrameworkApi.cs" />
    </ItemGroup>

</Project>
