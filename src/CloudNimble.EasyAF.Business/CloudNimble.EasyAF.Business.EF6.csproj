<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EntityFramework" Version="6.*" />
        <PackageReference Include="SimpleMessageBus.Publish" Version="[6.*-*, 7.0.0)" />
        <PackageReference Include="Z.EntityFramework.Plus.EF6" Version="10.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="System.Text.Json" Version="[11.*-*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="[11.*-*, 12.0.0)" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="System.Text.Json" Version="[10.*, 12.0.0)" />
        <!-- Dealing with security vulnerabilities -->
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="[10.*, 12.0.0)" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CloudNimble.EasyAF.Core\CloudNimble.EasyAF.Core.csproj" />
    </ItemGroup>

</Project>
