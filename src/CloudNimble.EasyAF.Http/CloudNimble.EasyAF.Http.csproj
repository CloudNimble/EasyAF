<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;netstandard2.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='net11.0'">
        <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.*" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[11.*-*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="[11.*-*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="[11.*-*, 12.0.0)" />
        <PackageReference Include="System.Net.Http.Json" Version="[11.*-*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.*" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="[10.*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="[10.*, 12.0.0)" />
        <PackageReference Include="System.Net.Http.Json" Version="[10.*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="[8.*, 12.0.0)" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="[8.*, 12.0.0)" />
        <PackageReference Include="System.Net.Http.Json" Version="[8.*, 12.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CloudNimble.EasyAF.Configuration\CloudNimble.EasyAF.Configuration.csproj" />
        <ProjectReference Include="..\CloudNimble.EasyAF.Core\CloudNimble.EasyAF.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <Compile Remove="DualHttpContextAccessor.cs" />
        <Compile Remove="InnerHttpContext.cs" />
    </ItemGroup>

</Project>
